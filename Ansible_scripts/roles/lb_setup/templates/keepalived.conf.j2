vrrp_script check_apiserver {
  script "/etc/keepalived/check_apiserver.sh"
  interval 3
  weight -2
  fall 10
  rise 2
}
vrrp_instance VI_1 {
    state {{ state_name }}            
    interface {{ interface_name }}  
    virtual_router_id 51    
    priority {{ priority_number }}            
    advert_int 1            
    authentication {
        auth_type PASS
        auth_pass 1234
    }
    virtual_ipaddress {
        192.168.1.100      
    }
}